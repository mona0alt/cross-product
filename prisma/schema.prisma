generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishableStatus {
  draft
  pending
  published
  archived
}

enum MessageStatus {
  new
  processed
}

enum BannerTargetType {
  category
  product
  url
}

enum SubscriberStatus {
  active
  unsubscribed
}

enum MailCampaignStatus {
  pending
  sent
  partial
  failed
}

enum MailDeliveryStatus {
  sent
  failed
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id                String            @id @default(cuid())
  parentId          String?
  slug              String            @unique
  sortOrder         Int               @default(0)
  iconImageUrl      String?
  isActive          Boolean           @default(true)
  nameZh            String
  nameEn            String
  nameEs            String
  namePt            String
  descriptionZh     String?
  descriptionEn     String?
  descriptionEs     String?
  descriptionPt     String?
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]        @relation("CategoryHierarchy")
  products          Product[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id             String            @id @default(cuid())
  categoryId     String
  slug           String            @unique
  productCode    String            @unique
  priceUsd       Decimal           @db.Decimal(10, 2)
  coverImageUrl  String
  status         PublishableStatus  @default(draft)
  isRecommended  Boolean           @default(false)
  sortOrder      Int               @default(0)
  publishedAt    DateTime?
  nameZh         String
  nameEn         String
  nameEs         String
  namePt         String
  introZh        String
  introEn        String
  introEs        String
  introPt        String
  detailZh       String
  detailEn       String
  detailEs       String
  detailPt       String
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  imageUrl   String
  altText    String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model Banner {
  id         String             @id @default(cuid())
  imageUrl   String
  targetType BannerTargetType
  targetId   String?
  targetUrl  String?
  sortOrder  Int                @default(0)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([isActive])
}

model Message {
  id          String        @id @default(cuid())
  name        String
  email       String
  content     String
  status      MessageStatus @default(new)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Subscriber {
  id         String            @id @default(cuid())
  email      String            @unique
  status     SubscriberStatus  @default(active)
  source     String?
  deliveries MailDelivery[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status])
}

model MailTemplate {
  id        String         @id @default(cuid())
  name      String
  subject   String
  body      String
  campaigns MailCampaign[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model MailCampaign {
  id             String              @id @default(cuid())
  templateId     String?
  templateName   String
  subject        String
  body           String
  status         MailCampaignStatus  @default(pending)
  recipientCount Int                 @default(0)
  successCount   Int                 @default(0)
  failureCount   Int                 @default(0)
  errorMessage   String?
  sentAt         DateTime?
  template       MailTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries     MailDelivery[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model MailDelivery {
  id           String             @id @default(cuid())
  campaignId   String
  subscriberId String?
  email        String
  status       MailDeliveryStatus
  errorMessage String?
  campaign     MailCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   Subscriber?        @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
}

model MailAutomationSetting {
  id           String   @id @default(cuid())
  singletonKey String   @unique
  trigger      String   @default("product_new")
  frequencyCap String   @default("daily")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialPost {
  id        String   @id @default(cuid())
  platform  String
  imageUrl  String
  targetUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
