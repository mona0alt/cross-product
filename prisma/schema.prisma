generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishableStatus {
  draft
  pending
  published
  archived
}

enum MessageStatus {
  new
  processed
}

enum BannerTargetType {
  category
  product
  url
}

enum SubscriberStatus {
  active
  unsubscribed
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id                String            @id @default(cuid())
  parentId          String?
  slug              String            @unique
  sortOrder         Int               @default(0)
  iconImageUrl      String?
  isActive          Boolean           @default(true)
  nameZh            String
  nameEn            String
  nameEs            String
  namePt            String
  descriptionZh     String?
  descriptionEn     String?
  descriptionEs     String?
  descriptionPt     String?
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]        @relation("CategoryHierarchy")
  products          Product[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id             String            @id @default(cuid())
  categoryId     String
  slug           String            @unique
  productCode    String            @unique
  priceUsd       Decimal           @db.Decimal(10, 2)
  coverImageUrl  String
  status         PublishableStatus  @default(draft)
  isRecommended  Boolean           @default(false)
  sortOrder      Int               @default(0)
  publishedAt    DateTime?
  nameZh         String
  nameEn         String
  nameEs         String
  namePt         String
  introZh        String
  introEn        String
  introEs        String
  introPt        String
  detailZh       String
  detailEn       String
  detailEs       String
  detailPt       String
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  imageUrl   String
  altText    String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model Banner {
  id         String             @id @default(cuid())
  imageUrl   String
  targetType BannerTargetType
  targetId   String?
  targetUrl  String?
  sortOrder  Int                @default(0)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([isActive])
}

model Message {
  id          String        @id @default(cuid())
  name        String
  email       String
  content     String
  status      MessageStatus @default(new)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Subscriber {
  id         String            @id @default(cuid())
  email      String            @unique
  status     SubscriberStatus  @default(active)
  source     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status])
}
